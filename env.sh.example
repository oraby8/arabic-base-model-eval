# Copy to env.sh and adjust.
export B=/path/to/arabic-base-model-eval          # this project's root
export TOK_EVAL=/path/to/arabic-tokenizer-eval    # source of the prepared held-out text (prep_eval.py)
export HF_HOME=$B/hf                              # models are downloaded here and deleted after evaluation
export TMPDIR=$B/tmp
export HF_XET_HIGH_PERFORMANCE=1
export TRITON_CACHE_DIR=$B/tmp/triton             # kernel cache (keep off a full root disk)
